{
  "name": "bpai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:check": "node ./scripts/db-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:import-store": "node ./scripts/db-import-store.mjs",
    "db:import-store:reset": "node ./scripts/db-import-store.mjs --reset",
    "db:migrate": "node ./scripts/db-migrate.mjs",
    "db:seed:work-orders": "node ./scripts/db-seed-work-orders.mjs",
    "smoke:bp-ask:dispatch": "node ./scripts/bp-ask-dispatch-regression.mjs",
    "smoke:bp-ask:skill": "node ./scripts/bp-ask-skill-runner-smoke.mjs",
    "smoke:bp-ask:workflow": "node ./scripts/bp-ask-workflow-runner-smoke.mjs",
    "smoke:bp-ask:writeback": "node ./scripts/bp-ask-controlled-writeback-smoke.mjs",
    "smoke:bp-ask:work-order-mutation": "node ./scripts/bp-ask-work-order-mutation-smoke.mjs",
    "smoke:bp-ask:document-chain": "node ./scripts/bp-ask-document-chain-smoke.mjs",
    "smoke:ai-tools:registry": "node ./scripts/ai-tools-registry-smoke.mjs",
    "smoke:ai-tools:direct-mutation": "node ./scripts/ai-tools-direct-mutation-smoke.mjs",
    "smoke:bp-ask": "node ./scripts/bp-ask-memory-smoke.mjs",
    "smoke:engineering": "node ./scripts/engineering-backend-smoke.mjs",
    "smoke:work-orders": "node ./scripts/work-order-backend-smoke.mjs",
    "db:studio": "drizzle-kit studio",
    "cad:lab:sync-assets": "node ./scripts/cad-lab-sync-assets.mjs",
    "cad:lab:dev": "npm run cad:lab:sync-assets && vite --config cad-lab/vite.config.ts",
    "cad:lab:publish": "node ./scripts/cad-lab-publish.mjs",
    "cad:lab:build": "npm run cad:lab:sync-assets && vite build --config cad-lab/vite.config.ts && npm run cad:lab:publish"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@mlightcad/cad-simple-viewer": "^1.4.11",
    "@mlightcad/cad-viewer": "^1.4.11",
    "@mlightcad/data-model": "^1.7.14",
    "@types/leaflet": "^1.9.21",
    "@vueuse/core": "^11.3.0",
    "drizzle-orm": "^0.45.2",
    "element-plus": "^2.13.6",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "next": "16.2.1",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "^0.172.0",
    "vue": "^3.5.32",
    "vue-i18n": "^10.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-vue": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.1"
  }
}
